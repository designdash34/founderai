<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="8dp"
    android:paddingHorizontal="4dp">

    <!-- Timeline Column -->
    <LinearLayout
        android:layout_width="20dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginEnd="12dp">

        <View
            android:id="@+id/timeline_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_status_dot"
            android:layout_marginTop="4dp" />

        <View
            android:id="@+id/timeline_line"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/color_divider"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="2dp"
            android:minHeight="30dp" />

    </LinearLayout>

    <!-- Content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingBottom="4dp">

        <!-- Agent Badge + Time Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tv_activity_agent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/agent_intake"
                android:textColor="@color/color_primary"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp" />

            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_activity_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Just now"
                android:textColor="@color/color_text_tertiary"
                android:textSize="11sp"
                android:fontFamily="sans-serif" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_activity_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="System initialized and ready for analysis."
            android:textColor="@color/color_text_secondary"
            android:textSize="13sp"
            android:fontFamily="sans-serif"
            android:lineSpacingMultiplier="1.2" />

    </LinearLayout>

</LinearLayout>
