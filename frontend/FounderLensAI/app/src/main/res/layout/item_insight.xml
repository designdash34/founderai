<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/color_card"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/color_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10px">

            <!-- Type Badge -->
            <TextView
                android:id="@+id/tv_type_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="⚠ RISK"
                android:textColor="@color/color_error"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_error_badge"
                android:paddingHorizontal="9dp"
                android:paddingVertical="4dp"
                android:letterSpacing="0.08"
                android:layout_marginEnd="10dp" />

            <!-- Agent Source -->
            <TextView
                android:id="@+id/tv_insight_agent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/agent_insight"
                android:textColor="@color/color_text_tertiary"
                android:textSize="12sp"
                android:fontFamily="sans-serif" />

            <!-- Impact/Severity -->
            <TextView
                android:id="@+id/tv_impact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/high"
                android:textColor="@color/color_error"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium" />

        </LinearLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/tv_insight_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Revenue decline in Q3 detected"
            android:textColor="@color/color_text_primary"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="8dp" />

        <!-- Description -->
        <TextView
            android:id="@+id/tv_insight_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Analysis shows a 23% drop in revenue compared to Q2."
            android:textColor="@color/color_text_secondary"
            android:textSize="13sp"
            android:fontFamily="sans-serif"
            android:lineSpacingMultiplier="1.5"
            android:layout_marginBottom="12dp" />

        <!-- Confidence Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Confidence:"
                android:textColor="@color/color_text_tertiary"
                android:textSize="11sp"
                android:fontFamily="sans-serif"
                android:layout_marginEnd="8dp" />

            <ProgressBar
                android:id="@+id/confidence_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="1"
                android:progress="87"
                android:progressTint="@color/color_primary"
                android:progressBackgroundTint="@color/color_stroke" />

            <TextView
                android:id="@+id/tv_confidence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="87% confidence"
                android:textColor="@color/color_primary"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="8dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
