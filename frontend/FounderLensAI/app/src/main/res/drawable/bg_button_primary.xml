<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#3A6FE0"
                android:endColor="#22BFDA"
                android:type="linear" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#4F8CFF"
                android:endColor="#38DDF8"
                android:type="linear" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
